# Dependencies and package-manager caches
/node_modules
/.pnp
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and generated framework state
/.next/
/out/
/dist/
/.sanity/
