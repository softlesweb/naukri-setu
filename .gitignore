.pnpm-debug.log*
*.log

# Local environment files; the documented template remains versioned
.env*
!.env.example

# Local deployment and tool state
/.vercel/
/outputs/
/work/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
*.pem
