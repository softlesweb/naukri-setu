# Public identifiers are safe to expose to the browser. Never place a write
# token in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Studio uses its own environment-variable prefix. Repeat the same
# literal project ID and dataset values here; .env files do not expand aliases.
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Optional server-only Viewer token. It is required for private datasets.
# Never use a write token here or prefix it with NEXT_PUBLIC_/SANITY_STUDIO_.
SANITY_API_READ_TOKEN=
