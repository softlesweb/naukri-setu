# Public identifiers are safe to expose to the browser. Never place a write
# token in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Studio runs in a browser bundle and only exposes SANITY_STUDIO_ names.
# dotenv-expand keeps these aliases synchronized with the Next.js variables.
SANITY_STUDIO_PROJECT_ID=${NEXT_PUBLIC_SANITY_PROJECT_ID}
SANITY_STUDIO_DATASET=${NEXT_PUBLIC_SANITY_DATASET}

# Server-only Viewer token, required when the Sanity dataset is private.
# Never prefix this variable with NEXT_PUBLIC_ or SANITY_STUDIO_.
SANITY_API_READ_TOKEN=
